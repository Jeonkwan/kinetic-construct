{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Kinetic Construct",
  "version": "1.2.3",
  "description": "High-density editorial design system with tactile chrome, Warm Alabaster surfaces, and Botanical Field semantic accents.",
  "tokens": {
    "surfaces": {
      "canvas": "#F4F0E6",
      "surface": "#FAF7F0",
      "well": "#EAE4D7"
    },
    "ink": {
      "primary": "#111111",
      "prose": "#222222",
      "muted": "#4A4740"
    },
    "semanticAccents": {
      "module": {
        "hex": "#3730A3",
        "surface": "#E0E7FF",
        "role": "Blueprint / Reusable Source / Module"
      },
      "root": {
        "hex": "#15803D",
        "surface": "#DCFCE7",
        "role": "Execution Entry Configuration / Runtime Boundary / Active Service"
      },
      "state": {
        "hex": "#9A3412",
        "surface": "#FFEDD5",
        "role": "Remote Ledger / State File / Database"
      }
    },
    "typography": {
      "display": {
        "family": "Fraunces, Georgia, serif",
        "weights": [
          700,
          800
        ]
      },
      "prose": {
        "family": "Bitter, Georgia, serif",
        "size": "0.9375rem",
        "pixelEquivalent": "15px",
        "lineHeight": 1.55,
        "maxMeasure": "65ch"
      },
      "mono": {
        "family": "Fira Code, monospace",
        "size": "0.8125rem",
        "pixelEquivalent": "13px",
        "lineHeight": 1.55
      }
    },
    "chrome": {
      "border": "2px solid #111111",
      "shadow": "2px 2px 0px #111111",
      "shadowHover": "4px 4px 0px #111111",
      "shadowActive": "1px 1px 0px #111111",
      "radius": "6px"
    },
    "layout": {
      "railWidth": "220px",
      "containerMax": "1520px",
      "outerGutter": "clamp(12px, 1.8vw, 24px)",
      "sectionGap": "22px",
      "cardPadding": "14px",
      "wellPadding": "12px",
      "gridGap": "12px",
      "mobileNavigation": "<=960px: non-sticky horizontal scrolling row"
    },
    "codeBlock": {
      "theme": "alabaster-book",
      "background": "#EAE4D7",
      "headerBackground": "#DFD7C7",
      "text": "#1C1917",
      "gutterNumbers": "#8C8270",
      "syntax": {
        "keyword": "#15803D",
        "string": "#9A3412",
        "type": "#3730A3",
        "attribute": "#0369A1",
        "comment": "#625D52",
        "punctuation": "#44403C"
      }
    },
    "actions": {
      "background": "#15803D",
      "foreground": "#FAF7F0"
    },
    "interaction": {
      "activeTranslate": "2px 2px",
      "selected": "neutral 2px outline, 2px offset, check mark, aria-pressed",
      "focus": "neutral 3px outline, 4px offset"
    },
    "diagram": {
      "viewBox": "0 0 880 480",
      "minWidth": "880px",
      "proseSize": "15px",
      "technicalSize": "13px",
      "nodeNameSize": "20px",
      "overflow": "local horizontal scroll"
    }
  },
  "darkOverrides": {
    "--bg-canvas": "#0E131B",
    "--bg-surface": "#161F2C",
    "--bg-well": "#1E293B",
    "--ink-primary": "#F1F5F9",
    "--ink-prose": "#E2E8F0",
    "--ink-muted": "#94A3B8",
    "--accent-module": "#818CF8",
    "--accent-module-bg": "rgba(99, 102, 241, 0.18)",
    "--accent-root": "#34D399",
    "--accent-root-bg": "rgba(16, 185, 129, 0.18)",
    "--accent-state": "#FB923C",
    "--accent-state-bg": "rgba(249, 115, 22, 0.18)",
    "--action-bg": "#34D399",
    "--action-ink": "#0E131B",
    "--code-bg": "#111618",
    "--code-header-bg": "#171E20",
    "--code-text": "#E5E9E7",
    "--code-num": "#5B6B67",
    "--syn-keyword": "#6EE7B7",
    "--syn-string": "#FDBA74",
    "--syn-type": "#93C5FD",
    "--syn-attr": "#C4B5FD",
    "--syn-comment": "#8C9D97",
    "--syn-punct": "#9CA3AF"
  },
  "tokenAuthority": "css/kinetic-serif.css; tokens are light values, darkOverrides use CSS variable names"
}
